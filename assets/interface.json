        //     "option": [
        //         "探险时间",
        //         "探险属性"
        //     ],
        //     "pipeline_override": {}
        // }
    ],
    "option": {
        "极品特招": {
            "type": "checkbox",
            "label": "极品特招",
            "description": "是否进行极品特招",
            "default_case": ["是"],
            "cases": [
                {
                    "name": "是",
                    "pipeline_override": {
                        "specialTravel": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "特招属性",
                    "option": [
                        "特招属性"
                    ]
                }
            ]
        },
        "特招属性": {
            "type": "select",
            "cases": [
                {
                    "name": "金",
                    "pipeline_override": {
                        "jin": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "木",
                    "pipeline_override": {
                        "mu": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "水",
                    "pipeline_override": {
                        "shui": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "火",
                    "pipeline_override": {
                        "huo": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "土",
                    "pipeline_override": {
                        "tu": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "雷",
                    "pipeline_override": {
                        "lei": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "邪",
                    "pipeline_override": {
                        "xie": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "体",
                    "pipeline_override": {
                        "ti": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "执行次数": {
            "type": "select",
            "label": "执行次数",
            "description": "选择执行次数",
            "default_case": "体力上限",
            "cases": [
                {
                    "name": "游历次数",
                    "option": [
                        "游历次数"
                    ]
                },
                {
                    "name": "体力上限",
                    "pipeline_override": {
                        "getVitality": {
                            "recognition": "DirectHit",
                            "action": "DoNothing"
                        }
                    }
                }
            ]
        },
        "游历次数": {
            "type": "input",
            "label": "游历次数",
            "description": "输入希望循环执行的次数",
            "inputs": [
                {
                    "name": "次数",
                    "label": "次数",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                }
            ],
            "pipeline_override": {
                "easyTravel": {
                    "max_hit": "{次数}"
                }
            }
        }
