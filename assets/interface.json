    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaLZ",
    "description": "我要当老祖自动化游历工具。",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MaaLZ!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/FelixTaXk/MaaLZ",
    "version": "v0.0.1.5",
    "icon": "logo.ico",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "agent": {
        "child_exec": "python",
        "child_args": ["./agent/main.py"]
    },
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "启动游戏",
            "entry": "startGame",
            "description": "启动游戏"
        },
        {
            "name": "一键游历",
            "entry": "easyTravel",
            "description": "自动一键游历",
            "option": [
                "极品特招",
                "执行次数"
            ]
        }
        // {
        //     "name": "一键收菜",
        //     "entry": "easyHarvest",
        //     "description": "自动一键收菜"
        // },
        // {
